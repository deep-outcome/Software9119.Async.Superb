<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../SharedProjectConfiguration.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0;</TargetFrameworks>
    <RootNamespace>Software9119.Async.Superb</RootNamespace>
    <AssemblyName>Software9119.Async.Superb</AssemblyName>
    <PackageOutputFolder>./../packages/</PackageOutputFolder>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageVersion>1.1.0</PackageVersion>
    <PackageReadmeFile>./README.md</PackageReadmeFile>
    <Description>Helpful and useful types for everyday async programming.</Description>
    <PackageTags>Async,Lock</PackageTags>
    <PackageProjectUrl>https://github.com/deep-outcome/Software9119.Async.Superb</PackageProjectUrl>
    <PackageIcon>ico.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Label="Info">
    <None Include="./../LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="./README.md" Pack="true" PackagePath="\" />
    <None Include="./../ico.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PackageId>$(AssemblyName).$(Configuration)</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PackageId>$(AssemblyName)</PackageId>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <Target Name="CopyPackage" AfterTargets="Pack">
    <Copy SourceFiles="$(OutputPath)\$(PackageId).$(PackageVersion).nupkg" DestinationFolder="$(PackageOutputFolder)" />
    <Copy SourceFiles="$(OutputPath)\$(PackageId).$(PackageVersion).snupkg" DestinationFolder="$(PackageOutputFolder)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
    <PackageReference Include="Software9119.ProxyNsAnalyzer" Version="1.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
